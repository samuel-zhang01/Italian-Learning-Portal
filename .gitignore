# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
._*
__MACOSX/
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/outputs/
/output/
/work/
/data/archive-*.json
/data/incoming/
/backups/local-data/
/tmp/
/.start.sh.swp

# Private study materials; keep the drop folder in the project.
/materials/inbox/*
!/materials/inbox/.gitkeep

# Python tools
.venv/
__pycache__/
*.py[cod]
